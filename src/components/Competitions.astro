---
import { competitions, ctfHighlights } from '../data/competitions';
import { profile } from '../data/profile';
import Icon from './Icon.astro';
---
<section id="competitions" class="wrap ctf-section" aria-labelledby="competition-title">
  <div class="competition-section"><div class="competition-icon" aria-hidden="true"><span>0x</span><span>UEMF</span></div><div class="competition-copy"><p class="eyebrow">0x03 / CTF & SECURITY COMPETITIONS</p><h2 id="competition-title">{competitions[0].title}</h2><p>{competitions[0].description}</p><a class="text-link competition-note" href={competitions[0].url}>{competitions[0].result} <Icon name="external" /></a></div><div class="competition-location"><span class="mini-label">TEAM 0xUEMF</span><span>NYU Abu Dhabi</span><span class="muted">MENA Finals</span></div></div>
  <div class="ctf-highlights">{ctfHighlights.map(item => <article><div><p class="mini-label">{item.team}</p><h3>{item.event}</h3><p>{item.context}</p></div><span class="ctf-result">{item.result}</span></article>)}</div>
  <div class="section-tail"><span>Competing as Awdyane. Team results, shared effort.</span><a class="text-link" href={profile.ctftime}>CTFtime profile <Icon name="external" /></a></div>
</section>
