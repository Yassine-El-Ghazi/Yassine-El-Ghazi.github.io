---
import { profile } from '../data/profile';
import Rail from './Rail.astro';
import Icon from './Icon.astro';
---
<section id="contact" class="section wrap report" aria-labelledby="contact-title">
  <Rail label="Contact" addr="004010a0" />
  <div class="report-main">
    <div class="contact-grid">
      <div>
        <h2 id="contact-title">Let’s talk security.</h2>
        <p class="sec-intro">Open to security projects, technical conversations, and opportunities to learn.</p>
      </div>
      <div class="contact-list">
        <a href={profile.linkedin}><span><span class="label k">LinkedIn</span><span class="v">yassine-elghazi</span></span><Icon name="external" /></a>
        <a href={profile.github}><span><span class="label k">GitHub</span><span class="v">Yassine-El-Ghazi</span></span><Icon name="external" /></a>
        <a href={profile.cv} download><span><span class="label k">Resume</span><span class="v">Download PDF</span></span><Icon name="download" /></a>
      </div>
      <a class="big-mail" href={`mailto:${profile.email}`}>{profile.email}</a>
    </div>
  </div>
</section>
