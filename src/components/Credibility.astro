---
import { featuredResult as r } from '../data/competitions';
import Icon from './Icon.astro';
---
<section class="wrap" aria-label="CSAW qualification result">
  <div class="cred">
    <dl>
      <div class="cell"><dt class="label">Event</dt><dd>{r.event}<span class="sub">{r.series}</span></dd></div>
      <div class="cell"><dt class="label">Result</dt><dd>{r.status}<span class="sub">Finals at NYU Abu Dhabi</span></dd></div>
      <div class="cell"><dt class="label">Global</dt><dd class="mono">{r.global}<span class="sub">{r.globalLabel}</span></dd></div>
      <div class="cell"><dt class="label">Team</dt><dd class="mono">{r.team}<span class="sub">Team result, not individual</span></dd></div>
    </dl>
    <div class="cred-foot"><p>Qualification ranking from the public CTFtime scoreboard.</p><a class="link" href={r.url}>View scoreboard <Icon name="external" /></a></div>
  </div>
</section>
