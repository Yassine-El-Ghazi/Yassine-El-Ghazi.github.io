---
import { ctfLog } from '../data/competitions';
import { profile } from '../data/profile';
import Rail from './Rail.astro';
import Icon from './Icon.astro';
const symbols = ctfLog.flatMap(g => g.entries.map(e => ({ id: e.id, label: e.event })));
---
<section id="ctf" class="section wrap report" aria-labelledby="ctf-title">
  <Rail label="CTF operation log" addr="00401040" symbols={symbols} />
  <div class="report-main">
    <h2 id="ctf-title">Flags captured as a team.</h2>
    <p class="sec-intro">Team results only. Seasonal rankings and individual scores are left out.</p>
    {ctfLog.map(group => (
      <>
        <p class="label log-year">{group.year}</p>
        <ol class="log">
          {group.entries.map(e => (
            <li id={e.id} class:list={['log-item', { lead: e.main }]}>
              <div><h3>{e.event}</h3><p class="log-result">{e.result}</p></div>
              <p class="log-team"><span class="label">{e.main ? 'Main team' : 'Team'}</span><b>{e.team}</b></p>
              <div>
                <p class="log-detail">{e.detail}{e.url && <> <a href={e.url}>CTFtime</a></>}</p>
                {e.rank && (() => { const pct = (e.rank.pos / e.rank.total) * 100; return (
                  <div class="track" role="img" aria-label={`Rank ${e.rank.pos} of ${e.rank.total.toLocaleString('en-US')} teams, top ${pct.toFixed(1)} percent`}>
                    <span>1</span><span class="line"><i style={`width:${pct}%`}></i><b style={`left:${pct}%`}></b></span><span>{e.rank.total.toLocaleString('en-US')}</span><em>top {pct.toFixed(1)}%</em>
                  </div>); })()}
              </div>
            </li>
          ))}
        </ol>
      </>
    ))}
    <div class="log-foot"><p>Competing as Awdyane, mainly with MDN_1CH94N. Team results are shared effort.</p><a class="link" href={profile.ctftime}>CTFtime profile <Icon name="external" /></a></div>
  </div>
</section>
