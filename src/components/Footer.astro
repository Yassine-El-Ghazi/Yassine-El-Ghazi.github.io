---
import { profile } from '../data/profile';
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <strong>Yassine El Ghazi</strong>
        <p>Cybersecurity engineering · Reverse engineering / malware analysis</p>
      </div>
      <nav class="footer-links" aria-label="Footer">
        <a href={profile.github}>GitHub</a>
        <a href={profile.linkedin}>LinkedIn</a>
        <a href={`mailto:${profile.email}`}>Email</a>
      </nav>
    </div>
    <div class="footer-end"><span>© {new Date().getFullYear()} · Built with Astro, hosted on GitHub Pages</span><span class="ret" aria-hidden="true">ret</span></div>
  </div>
</footer>
