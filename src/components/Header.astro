---
import { profile } from '../data/profile';
import Icon from './Icon.astro';
const home = Astro.url.pathname === '/';
const base = home ? '' : '/';
const items = [
  { id: 'work', label: 'Work' },
  { id: 'research', label: 'Research' },
  { id: 'ctf', label: 'CTF' },
  { id: 'about', label: 'About' },
  { id: 'contact', label: 'Contact' },
];
---
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={home ? '#top' : '/'}><span class="brand-mark" aria-hidden="true">YE</span><span>Yassine El Ghazi<span class="sr-only">, back to top</span></span></a>
    <nav class="site-nav" aria-label="Main navigation">
      {items.map(item => <a href={`${base}#${item.id}`} data-section={item.id}>{item.label}</a>)}
    </nav>
    <div class="header-actions">
      <a class="cv-link" href={profile.cv} download>Resume</a>
      <a href={profile.github} aria-label="Yassine El Ghazi on GitHub"><Icon name="github" /><span>GitHub</span></a>
    </div>
  </div>
  <div class="navband" aria-hidden="true"></div>
</header>
