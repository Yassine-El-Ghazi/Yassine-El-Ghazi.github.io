---
import { profile } from '../data/profile';
import { mainTeam } from '../data/competitions';
import sample from '../data/hero-sample.json';
import Icon from './Icon.astro';

// Everything in the workbench is generated from a real compile: see scripts/hero-sample/generate.py.
type Row = (typeof sample.rows)[number];
const ROW = 21, PAD = 8, GUT = 52;
const REG = /^(?:[re]?[abcd]x|[abcd][lh]|[re]?[sd]il?|[re]?[sb]pl?|r(?:8|9|1[0-5])[dwb]?)$/;
function tokens(r: Row) {
  if (r.branch) return [{ t: 'lab', v: 'loc_' + r.target }];
  return r.ops.replace(/,/g, ', ').split(/(,\s*|\[|\]|\+|\s+)/).filter(Boolean).map(p =>
    REG.test(p) ? { t: 'reg', v: p } : /^0x[0-9a-f]+$|^\d+$/i.test(p) ? { t: 'num', v: p } : { t: 'p', v: p });
}
function note(r: Row, i: number) {
  const b = sample.blocks.find(b => b.first === i);
  if (!b) return '';
  const from = r.xrefs.length ? '  ↑ ' + r.xrefs.join(' ') : '';
  return `; ${b.label}${from}`;
}

// Jump arrows in the listing gutter: shortest spans take the lowest lane.
const spans = sample.arrows.map(a => ({ ...a, lo: Math.min(a.from, a.to), hi: Math.max(a.from, a.to) })).sort((a, b) => a.hi - a.lo - (b.hi - b.lo));
const lanes: { lo: number; hi: number }[][] = [];
const placed = spans.map(s => {
  let lane = lanes.findIndex(l => l.every(o => s.hi < o.lo || s.lo > o.hi));
  if (lane < 0) { lane = lanes.length; lanes.push([]); }
  lanes[lane].push(s);
  return { ...s, lane };
});
const listH = PAD * 2 + sample.rows.length * ROW;
const yOf = (i: number) => PAD + i * ROW + ROW / 2;
const xEdge = GUT - 6;
const arrowPaths = placed.map(a => {
  const lx = xEdge - 10 - a.lane * 11;
  return { d: `M${xEdge} ${yOf(a.from)} H${lx} V${yOf(a.to)} H${xEdge - 5}`, tip: `${xEdge},${yOf(a.to)} ${xEdge - 6},${yOf(a.to) - 3.5} ${xEdge - 6},${yOf(a.to) + 3.5}`, kind: a.kind };
});

// Control-flow graph layout for this specific sample (5 blocks).
const N = [{ x: 105, y: 2 }, { x: 10, y: 84 }, { x: 10, y: 166 }, { x: 105, y: 262 }, { x: 205, y: 84 }];
const W = 150, H = 46;
const summary = sample.blocks.map(b => {
  const last = sample.rows[b.last];
  const n = b.last - b.first + 1;
  return `${n} insns` + (last.branch || last.ret ? ` · ${last.mn}` : '');
});
const cfgEdges = [
  { k: 'taken', d: 'M215 48 C215 68 280 64 280 84', tip: '280,84', dir: 'down' },
  { k: 'fall', d: 'M145 48 C145 68 85 64 85 84', tip: '85,84', dir: 'down' },
  { k: 'fall', d: 'M85 130 V166', tip: '85,166', dir: 'down' },
  { k: 'loop', d: 'M160 200 C198 202 198 178 166 180', tip: '160,180', dir: 'left' },
  { k: 'fall', d: 'M85 212 C85 240 150 236 150 262', tip: '150,262', dir: 'down' },
  { k: 'jump', d: 'M280 130 C280 200 210 220 210 262', tip: '210,262', dir: 'down' },
];
const head = (tip: string, dir: string) => { const [x, y] = tip.split(',').map(Number); return dir === 'left' ? `${x},${y} ${x + 6},${y - 3.5} ${x + 6},${y + 3.5}` : `${x},${y} ${x - 3.5},${y - 6} ${x + 3.5},${y - 6}`; };

const KW = /\b(int|unsigned|const|char|for|return)\b/g;
const hl = (line: string) => line.trim().startsWith('/*') ? `<i class="cm">${line}</i>` : line.replace(/\b(0x[0-9A-Fa-f]+u?|\d+u?)\b/g, '<i class="nu">$1</i>').replace(KW, '<i class="kw">$1</i>');
const perms = (f: string) => (f.includes('A') ? 'R' : '-') + (f.includes('W') ? 'W' : '-') + (f.includes('X') ? 'X' : '-');
const gccVer = sample.file.compiler.match(/\d+\.\d+\.\d+$/)?.[0] ?? '';
---
<div class="hero-shell">
<section class="hero wrap" aria-labelledby="hero-title">
  <ul class="hero-focus label" aria-label="Focus areas">
    <li>Reverse engineering</li><li>Malware analysis</li><li>Cybersecurity engineering</li>
  </ul>
  <h1 id="hero-title"><span>Yassine</span> <span>El Ghazi</span></h1>
  <div class="hero-sub">
    <p class="hero-lede">I take software apart to understand how it works.</p>
    <div class="hero-side">
      <p class="hero-support">Final-year cybersecurity engineering student at UEMF, working on reverse engineering, malware analysis, offensive security, and systems and network security.</p>
      <div class="hero-cta">
        <a class="btn primary" href="#work">View selected work <Icon class="go" /></a>
        <div class="hero-links">
          <a class="btn" href={profile.github}>GitHub <Icon name="external" class="ext" /></a>
          <a class="btn" href={profile.cv} download>Resume <Icon name="download" /></a>
          <a class="btn" href={profile.linkedin}>LinkedIn <Icon name="external" class="ext" /></a>
        </div>
        <a class="hero-cred" href={mainTeam.anchor}><span class="label">Team {mainTeam.team}</span><span>{mainTeam.result}, {mainTeam.event}</span><Icon /></a>
      </div>
    </div>
  </div>

  <figure class="wb">
    <dl class="wb-bar" aria-hidden="true">
      <div><dt class="label">File</dt><dd>sample · {sample.file.format}</dd></div>
      <div class="wb-arch"><dt class="label">Arch</dt><dd>{sample.file.arch}</dd></div>
      <div class="wb-cc"><dt class="label">Built with</dt><dd>gcc {gccVer} -O1</dd></div>
      <div><dt class="label">Function</dt><dd class="amber">{sample.function.name}</dd></div>
      <div class="wb-size"><dt class="label">Size</dt><dd>{sample.function.bytes} bytes @ {sample.function.fileOffset}</dd></div>
    </dl>
    <div class="wb-panes">
      <section class="pane pane-list" aria-hidden="true">
        <header class="pane-h"><span class="label">Listing</span><span class="label hint">Hover or tap a row</span></header>
        <div class="listing-scroll">
          <div class="rows" style={`height:${listH}px`}>
            <svg class="gutter" width={GUT} height={listH} viewBox={`0 0 ${GUT} ${listH}`} focusable="false">
              {arrowPaths.map(a => <><path class={`ar ${a.kind}`} d={a.d} /><polygon class={`ah ${a.kind}`} points={a.tip} /></>)}
            </svg>
            <ol class="listing">
              {sample.rows.map((r, i) => (
                <li class={`row b${r.block}`} style={`height:${ROW}px`} tabindex="-1">
                  <span class="a">{r.addr}</span><span class="by">{r.bytes}</span>
                  <span class="asm"><span class={r.branch || r.ret ? 'mn br' : 'mn'}>{r.mn}</span>{tokens(r).map(t => t.t === 'p' ? t.v : <span class={t.t}>{t.v}</span>)}{note(r, i) && <span class="note">{'  ' + note(r, i)}</span>}</span>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>

      <section class="pane pane-graph">
        <header class="pane-h"><span class="label">Graph</span><span class="label">{sample.blocks.length} blocks · {sample.edges.length} edges</span></header>
        <div class="cfg">
          <svg viewBox="0 0 360 316" role="group" aria-label="Control-flow graph of the compiled function. Focus a block to highlight its instructions.">
            {cfgEdges.map(e => <><path aria-hidden="true" class={`edge ${e.k}`} d={e.d} pathLength="1" /><polygon aria-hidden="true" class={`eh ${e.k}`} points={head(e.tip, e.dir)} /></>)}
            {sample.blocks.map((b, i) => (
              <g class={`node n${i}`} tabindex="0" role="img" aria-label={`Block ${b.label}: ${summary[i].replace('insns', 'instructions')}`}><rect aria-hidden="true" x={N[i].x} y={N[i].y} width={W} height={H} rx="6" /><text class="t1" x={N[i].x + W / 2} y={N[i].y + 19} text-anchor="middle">{b.label}</text><text x={N[i].x + W / 2} y={N[i].y + 36} text-anchor="middle">{summary[i]}</text></g>
            ))}
          </svg>
          <p class="legend" aria-hidden="true"><span class="lg fall"></span>fall-through <span class="lg taken"></span>taken / loop <span class="lg jump"></span>jmp</p>
        </div>
      </section>

      <details class="pane pane-info">
        <summary class="pane-h"><span class="label">Source · sections · ELF header</span><span class="peek" aria-hidden="true"><b>{sample.elfHeader.slice(0, 11)}</b>  .ELF · {sample.sections.length} sections · 6 lines of C</span><span class="label more" aria-hidden="true">+</span></summary>
        <div class="info-grid">
        <div class="sub">
          <header class="pane-h"><span class="label">Source</span><span class="label">C</span></header>
          <pre class="src"><code set:html={sample.source.slice(1, 7).map(hl).join('\n')} /></pre>
        </div>
        <div class="sub">
          <header class="pane-h"><span class="label">Sections</span><span class="label">readelf -S</span></header>
          <table class="secs"><thead><tr><th scope="col">name</th><th scope="col">addr</th><th scope="col">size</th><th scope="col">perm</th></tr></thead><tbody>
            {sample.sections.map(s => <tr><th scope="row">{s.name}</th><td>{s.addr}</td><td>{s.size}</td><td>{perms(s.flags)}</td></tr>)}
          </tbody></table>
        </div>
        <div class="sub">
          <header class="pane-h"><span class="label">ELF header</span><span class="label">16 bytes</span></header>
          <div class="hexline"><span class="hl"><span class="hx">00000000</span>  <span class="magic">{sample.elfHeader.slice(0, 11)}</span> {sample.elfHeader.slice(12, 23)}  |<span class="magic">.ELF</span>....|</span><span class="hl"><span class="hx">00000008</span>  {sample.elfHeader.slice(24)}  |........|</span></div>
        </div>
        </div>
      </details>
    </div>
    <figcaption>
      <span class="label">Real output, not a real sample</span>
      <span>A 6-line C hash check written for this page, built with gcc and disassembled with objdump (<span class="mono">scripts/hero-sample</span>). Not malware, not from my projects.</span>
      <span class="sr-only">Workbench showing the real disassembly of a small compiled C function, its control-flow graph, source, ELF section table and header bytes.</span>
    </figcaption>
  </figure>
</section>
</div>
