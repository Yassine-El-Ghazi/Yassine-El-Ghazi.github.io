---
import { projects } from '../data/projects';
import Icon from './Icon.astro';
import AnalysisVisual from './AnalysisVisual.astro';
const [featured, ...others] = projects;
---
<section id="projects" class="section wrap" aria-labelledby="projects-title">
  <div class="section-heading"><div><p class="eyebrow">0x01 / SELECTED WORK</p><h2 id="projects-title">Analysis meets engineering.</h2></div><p>Four projects, from APK features<br class="desktop-break" /> to packets and system state.</p></div>
  <article class="featured-project">
    <div class="featured-copy"><p class="eyebrow">{featured.category}</p><h3>{featured.name}</h3><p>{featured.description}</p><ul class="tags" aria-label="Project technologies">{featured.tags.map(tag => <li>{tag}</li>)}</ul><div class="project-outcome"><span class="mini-label">ENGINEERING TAKEAWAY</span><p>{featured.outcome}</p></div><a class="text-link" href={featured.url}>View malware detector repository <Icon name="external" /></a></div>
    <AnalysisVisual variant="malware" />
  </article>
  <div class="project-grid">{others.map((project, index) => <article class="project-card">
    <div class="project-card-top"><span class="mini-label">0x0{index + 2}</span><span class="project-symbol" aria-hidden="true">{project.motif === 'soc' ? 'LOG' : project.motif === 'network' ? 'HA' : 'SYS'}</span></div>
    <p class="eyebrow">{project.category}</p><h3>{project.name}</h3><p>{project.description}</p><ul class="tags" aria-label="Project technologies">{project.tags.map(tag => <li>{tag}</li>)}</ul><div class="project-outcome"><span class="mini-label">TAKEAWAY</span><p>{project.outcome}</p></div><a class="text-link" href={project.url} aria-label={`View repository: ${project.name}`}>View repository <Icon name="external" /></a>
  </article>)}</div>
  <div class="section-tail"><span>A selection of public work. More on GitHub.</span><a class="text-link" href="https://github.com/Yassine-El-Ghazi?tab=repositories">All repositories <Icon /></a></div>
</section>
