---
import Rail from './Rail.astro';
import Icon from './Icon.astro';
const areas = [
  { id: 'r-binary', name: 'Binary reversing', text: 'Ghidra-based disassembly and decompilation, practiced on reverse-engineering and binary challenges in CTFs: recovering behavior from machine code.', href: '#ctf', evidence: 'CTF log' },
  { id: 'r-static', name: 'Static analysis and malware triage', text: 'Reading what a program declares before running it: manifest permissions and intent actions feed an explainable classifier, and the APK is never executed. Obfuscation and dynamic payloads are what it misses.', href: '#p-android', evidence: 'Android Malware Detection' },
  { id: 'r-traffic', name: 'Protocol and traffic analysis', text: 'Verifying behavior at packet level: ESP on the WAN side against RDP on the LAN side in Wireshark, and flow debugging a tunnel that negotiated but dropped return traffic.', href: '#p-forti', evidence: 'FortiGate VPN & HA Lab' },
];
const symbols = [...areas.map(a => ({ id: a.id, label: a.name })), { id: 'r-writeups', label: 'Writeups' }];
---
<section id="research" class="section wrap report" aria-labelledby="research-title">
  <Rail label="Research" addr="00401020" symbols={symbols} />
  <div class="report-main">
    <h2 id="research-title">Understanding software below the source.</h2>
    <div class="focus-grid">
      <ul class="focus-list">
        {areas.map(a => (
          <li id={a.id}>
            <h3>{a.name}</h3>
            <p>{a.text}</p>
            <a class="evidence" href={a.href}><span class="xref" aria-hidden="true">; xref</span>{a.evidence} <Icon /></a>
          </li>
        ))}
      </ul>
      <div class="writeups-note" id="r-writeups">
        <div>
          <p class="label">Research / writeups</p>
          <h3 id="writeups-title">Coming as I publish analyses.</h3>
        </div>
        <p>None are published yet. Each will carry what makes an analysis checkable:</p>
        <ul aria-label="Planned writeup contents"><li>disassembly</li><li>pseudocode</li><li>call graphs</li><li>hexdumps</li><li>strings</li><li>method notes</li></ul>
      </div>
    </div>
  </div>
</section>
