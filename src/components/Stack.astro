---
import { toolXrefs } from '../data/profile';
import Rail from './Rail.astro';
import Icon from './Icon.astro';
---
<section id="stack" class="section wrap report" aria-labelledby="stack-title">
  <Rail label="Technical stack" addr="00401060" />
  <div class="report-main">
    <h2 id="stack-title">Tools, traced to where I used them.</h2>
    <p class="sec-intro stack-intro">Cross-references, not ratings: each tool links to the public project that uses it.</p>
    <ul class="xrefs">
      {toolXrefs.map(x => (
        <li>
          <a class="xr" href={x.href}>{x.name} <Icon /></a>
          <ul class="tools" aria-label={`Tools used in ${x.name}`}>{x.tools.map(t => <li>{t}</li>)}</ul>
        </li>
      ))}
    </ul>
  </div>
</section>
