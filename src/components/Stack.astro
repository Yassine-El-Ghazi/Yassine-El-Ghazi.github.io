---
import { skills } from '../data/profile';
import SectionBar from './SectionBar.astro';
---
<section id="stack" class="section wrap" aria-labelledby="stack-title">
  <SectionBar label="Technical stack" />
  <h2 id="stack-title">Tools I work with.</h2>
  <div class="stack-grid">
    {skills.map(group => (
      <section aria-labelledby={`stack-${group.title.replace(/\W+/g, '-').toLowerCase()}`}>
        <h3 id={`stack-${group.title.replace(/\W+/g, '-').toLowerCase()}`}>{group.title}</h3>
        <ul>{group.items.map(item => <li>{item}</li>)}</ul>
      </section>
    ))}
  </div>
</section>
