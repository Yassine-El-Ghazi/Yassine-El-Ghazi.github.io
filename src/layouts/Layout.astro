---
import geistUrl from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import geistMonoUrl from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import { profile } from '../data/profile';
interface Props { title?: string; description?: string; noindex?: boolean; }
const { title = 'Yassine El Ghazi | Reverse Engineering & Malware Analysis', description = profile.description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#0b0c0e" />
    <meta name="color-scheme" content="dark" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={geistUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistMonoUrl} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Yassine El Ghazi" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <slot name="head" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script is:inline>
      // Navigation state and the scroll "navigator band". Everything else works without JavaScript.
      (function () {
        var ids = ['work', 'research', 'ctf', 'stack', 'about', 'contact'];
        var secs = ids.map(function (i) { return document.getElementById(i); }).filter(Boolean);
        if (!secs.length) return;
        var links = [].slice.call(document.querySelectorAll('.site-nav a[data-section]'));
        var lists = [].slice.call(document.querySelectorAll('.symbols')).map(function (ul) {
          return [].slice.call(ul.querySelectorAll('a[data-sym]')).map(function (a) { return { a: a, el: document.getElementById(a.getAttribute('data-sym')) }; }).filter(function (i) { return i.el; });
        });
        var band = document.querySelector('.navband');
        var mark = document.createElement('i');
        mark.className = 'mark';
        function flag(el, on) { if (on) el.setAttribute('aria-current', 'true'); else el.removeAttribute('aria-current'); }
        function spy() {
          var y = window.innerHeight * 0.35, cur = null;
          secs.forEach(function (s) { if (s.getBoundingClientRect().top <= y) cur = s.id; });
          links.forEach(function (a) { flag(a, a.getAttribute('data-section') === cur); });
          lists.forEach(function (items) {
            var best = null, bt = -1e9;
            items.forEach(function (i) { var t = i.el.getBoundingClientRect().top; if (t <= y && t > bt + 4) { best = i; bt = t; } });
            items.forEach(function (i) { flag(i.a, i === best); });
          });
        }
        function place() {
          var H = document.documentElement.scrollHeight;
          var p = (window.scrollY + window.innerHeight * 0.35) / H;
          mark.style.left = Math.min(1, Math.max(0, p)) * 100 + '%';
        }
        function build() {
          if (!band) return;
          var H = document.documentElement.scrollHeight, y = window.scrollY;
          var tops = [0].concat(secs.map(function (s) { return s.getBoundingClientRect().top + y; }), [H]);
          band.textContent = '';
          for (var i = 0; i < tops.length - 1; i++) {
            var s = document.createElement('i');
            s.className = 'seg t' + i;
            s.style.left = (tops[i] / H) * 100 + '%';
            s.style.width = ((tops[i + 1] - tops[i]) / H) * 100 + '%';
            band.appendChild(s);
          }
          band.appendChild(mark);
          place();
        }
        var tick = false;
        window.addEventListener('scroll', function () {
          if (tick) return;
          tick = true;
          requestAnimationFrame(function () { place(); spy(); tick = false; });
        }, { passive: true });
        window.addEventListener('resize', function () { build(); spy(); });
        window.addEventListener('load', function () { build(); spy(); });
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(function () { build(); spy(); });
        build();
        spy();
      })();
    </script>
  </body>
</html>
