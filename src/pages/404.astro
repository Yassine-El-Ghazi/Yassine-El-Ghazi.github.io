---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
---
<Layout title="Page not found | Yassine El Ghazi" noindex>
  <Header />
  <main id="main" class="wrap not-found">
    <p class="label">404 · page not found</p>
    <h1>This address is not mapped.</h1>
    <p>The page may have moved. My projects and contact details are on the homepage.</p>
    <a class="btn primary" href="/">Return to portfolio <Icon class="go" /></a>
  </main>
  <Footer />
</Layout>
