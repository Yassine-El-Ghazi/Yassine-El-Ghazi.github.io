---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/writeup.css';
const entries = (await getCollection('writeups', e => !e.data.draft)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const empty = entries.length === 0;
---
<Layout title="Research & writeups | Yassine El Ghazi" description="Reverse engineering and malware analysis writeups by Yassine El Ghazi." noindex={empty}>
  <Header />
  <main id="main" class="wrap">
    <header class="writeup-head">
      <p class="label">Research / writeups</p>
      <h1>Analyses, with the evidence.</h1>
      <p class="summary">Reverse engineering, malware analysis, and vulnerability research notes.</p>
    </header>
    <div style="padding-block: 40px 0">
      {empty ? (
        <div class="empty-state"><h2>Coming as I publish analyses.</h2><p>Nothing is published yet. Each writeup will include the disassembly, pseudocode, graphs, and method notes needed to check the conclusions.</p><a class="back-link" href="/#research">← Back to research focus</a></div>
      ) : (
        <ul class="entry-list">
          {entries.map(e => <li><p class="label">{e.data.category.replace(/-/g, ' ')} · {e.data.date.toISOString().slice(0, 10)}</p><h2><a href={`/writeups/${e.id}/`}>{e.data.title}</a></h2><p>{e.data.summary}</p></li>)}
        </ul>
      )}
    </div>
  </main>
  <Footer />
</Layout>
